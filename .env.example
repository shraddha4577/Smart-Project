# Smart Waste Management Digital Twin Configuration
PROJECT_NAME="Smart Waste Management Digital Twin"
DATABASE_URL="sqlite:///./smart_waste.db"

# Optional: Google Gemini API Key
# If not provided, the system seamlessly uses the local Rule-Based Campus Heuristic Intelligence Engine

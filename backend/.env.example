# Smart Waste Management Digital Twin Backend Configuration
PROJECT_NAME="Smart Waste Management Digital Twin"
DATABASE_URL="sqlite:///./smart_waste.db"

# Optional: Google Gemini API Key for Generative AI Recommendations
# If left empty, the system automatically uses the intelligent Rule-Based Campus Heuristics Engine
GEMINI_API_KEY=""

# Configurable Thresholds (%)
WARNING_THRESHOLD=70.0
CRITICAL_THRESHOLD=90.0
SIMULATION_INTERVAL_SEC=8

# Campus Geofence Coordinates (Default: Central Campus Quad)
MAP_DEFAULT_LAT=12.9716
MAP_DEFAULT_LNG=77.5946
MAP_DEFAULT_ZOOM=16
